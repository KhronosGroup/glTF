{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "glTF.KHR_audio_environment.schema.json",
    "title": "KHR_audio_environment glTF Document Extension",
    "type": "object",
    "allOf": [{ "$ref": "glTFProperty.schema.json" }],
    "properties": {
        "listeners": {
            "type": "array",
            "description": "An array of listeners.",
            "items": { "$ref": "listener.schema.json" },
            "minItems": 1
        },
        "environments": {
            "type": "array",
            "description": "An array of acoustic environments.",
            "items": { "$ref": "environment.schema.json" },
            "minItems": 1
        },
        "extensions": {},
        "extras": {}
    },
    "anyOf": [
        { "required": ["listeners"] },
        { "required": ["environments"] }
    ]
}
