{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "graph.node.schema.json",
    "title": "Behavior graph interactivity node",
    "type": "object",
    "$ref": "glTFProperty.schema.json",
    "properties": {
        "configuration": {
            "title": "The configuration.",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "$ref": "glTFProperty.schema.json",
                "properties": {
                    "value": {
                        "title": "The value.",
                        "type": "array",
                        "minItems": 1
                    }
                }
            },
            "minProperties": 1
        },
        "declaration": {
            "title": "The declaration index.",
            "$ref": "glTFid.schema.json"
        },
        "flows": {
            "title": "The output flow sockets.",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "$ref": "glTFProperty.schema.json",
                "properties": {
                    "node": {
                        "title": "The index of the interactivity node to be activated.",
                        "$ref": "glTFid.schema.json"
                    },
                    "socket": {
                        "title": "The id of the input flow socket of the interactivity node to be activated.",
                        "type": "string",
                        "default": "in"
                    }
                },
                "required": [ "node" ]
            },
            "minProperties": 1
        },
        "values": {
            "title": "The input value sockets.",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "$ref": "glTFProperty.schema.json",
                "properties": {
                    "node": {
                        "title": "The index of the interactivity node.",
                        "$ref": "glTFid.schema.json"
                    },
                    "socket": {
                        "title": "The id of the output value socket of the interactivity node.",
                        "type": "string",
                        "default": "value"
                    },
                    "type": {
                        "title": "The type index.",
                        "$ref": "glTFid.schema.json"
                    },
                    "value": {
                        "title": "The inline input socket value.",
                        "type": "array",
                        "minItems": 1
                    }
                },
                "dependentRequired": {
                    "socket": [ "node" ],
                    "value": [ "type" ]
                },
                "not": { "required": [ "node", "value" ] },
                "anyOf": [
                    { "required": [ "node" ] },
                    { "required": [ "type" ] }
                ]
            },
            "minProperties": 1
        }
    },
    "required": [ "declaration" ]
}
