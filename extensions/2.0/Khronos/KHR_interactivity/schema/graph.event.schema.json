{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "graph.event.schema.json",
    "title": "Behavior graph event",
    "type": "object",
    "$ref": "graph.nameableProperty.schema.json",
    "properties": {
        "id": {
            "title": "The event id.",
            "type": "string"
        },
        "values": {
            "title": "The event value sockets.",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "$ref": "glTFProperty.schema.json",
                "properties": {
                    "type": {
                        "title": "The type index.",
                        "$ref": "glTFid.schema.json"
                    },
                    "value": {
                        "title": "The initial value.",
                        "type": "array",
                        "minItems": 1
                    }
                },
                "required": [ "type" ]
            },
            "minProperties": 1,
            "not": { "required": [ "event" ] }
        }
    }
}
