{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schema.khronos.org/gltf/2.1/specification/shape.convexMesh.schema.json",
    "title": "Convex Mesh Shape",
    "type": "object",
    "description": "A convex triangular mesh shape.",
    "allOf": [ { "$ref": "glTFProperty.schema.json" } ],
    "properties": {
        "mesh": {
            "allOf": [ { "$ref": "glTFid.schema.json" } ],
            "description": "The index of the mesh defining the geometry for this shape."
        }
    },
    "required": [ "mesh" ]
}
