{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "textureTransform.schema.json",
    "title": "Texture Transform",
    "type": "object",
    "allOf": [
        {
            "$ref": "glTFProperty.schema.json"
        }
    ],
    "properties": {
        "offset": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "default": [
                0,
                0
            ],
            "description": "UV translation in normalized texture coordinates."
        },
        "rotation": {
            "type": "number",
            "default": 0,
            "description": "UV rotation in radians, using the KHR_texture_transform matrix convention."
        },
        "scale": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "default": [
                1,
                1
            ],
            "description": "UV scale applied before rotation and translation."
        }
    }
}
