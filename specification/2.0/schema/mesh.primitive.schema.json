{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schema.khronos.org/gltf/2.0/specification/mesh.primitive.schema.json",
    "title": "Mesh Primitive",
    "type": "object",
    "description": "Geometry to be rendered with the given material.",
    "$ref": "glTFProperty.schema.json",
    "properties": {
        "attributes": {
            "type": "object",
            "description": "A JSON object that maps attribute semantic names to the indices of accessors providing the corresponding data.",
            "minProperties": 1,
            "additionalProperties": {
                "title": "Vertex Attribute Accessor",
                "$ref": "glTFid.schema.json"
            }
        },
        "indices": {
            "title": "Vertex Indices Accessor",
            "$ref": "glTFid.schema.json",
            "description": "The index of the accessor that provides the vertex indices. When undefined, the mesh primitive uses non-indexed geometry."
        },
        "material": {
            "title": "Material",
            "$ref": "glTFid.schema.json",
            "description": "The index of the material to apply to the mesh primitive."
        },
        "mode": {
            "title": "Topology Type",
            "type": "integer",
            "description": "The topology type of the mesh primitive.",
            "default": 4,
            "anyOf": [
                {
                    "title": "Point List",
                    "const": 0
                },
                {
                    "title": "Line List",
                    "const": 1
                },
                {
                    "title": "Line Loop",
                    "const": 2
                },
                {
                    "title": "Line Strip",
                    "const": 3
                },
                {
                    "title": "Triangle List",
                    "const": 4
                },
                {
                    "title": "Triangle Strip",
                    "const": 5
                },
                {
                    "title": "Triangle Fan",
                    "const": 6
                },
                {
                    "title": "Custom Topology Type",
                    "type": "integer"
                }
            ]
        },
        "targets": {
            "type": "array",
            "description": "An array of morph targets.",
            "items": {
                "type": "object",
                "additionalProperties": {
                    "title": "Vertex Attribute Accessor",
                    "$ref": "glTFid.schema.json"
                },
                "description": "A JSON object that maps attribute semantic names to the indices of accessors providing the corresponding morph target difference values."
            },
            "minItems": 1
        }
    },
    "required": [ "attributes" ]
}
