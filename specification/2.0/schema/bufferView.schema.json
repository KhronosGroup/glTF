{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schema.khronos.org/gltf/2.0/specification/bufferView.schema.json",
    "title": "Buffer View",
    "type": "object",
    "description": "A span of bytes in a buffer.",
    "$ref": "glTFChildOfRootProperty.schema.json",
    "properties": {
        "buffer": {
            "title": "Buffer",
            "$ref": "glTFid.schema.json",
            "description": "The index of the buffer."
        },
        "byteLength": {
            "type": "integer",
            "description": "The length of the buffer view in bytes.",
            "minimum": 1
        },
        "byteOffset": {
            "type": "integer",
            "description": "The offset into the buffer in bytes.",
            "minimum": 0,
            "default": 0
        },
        "byteStride": {
            "type": "integer",
            "description": "The stride, in bytes, between consecutive vertex attribute values.",
            "minimum": 4,
            "maximum": 252,
            "multipleOf": 4
        },
        "target": {
            "type": "integer",
            "description": "The optional hint specifying buffer view usage.",
            "anyOf": [
                {
                    "title": "Vertex Array",
                    "const": 34962,
                    "description": "The buffer view is used for vertex attributes."
                },
                {
                    "title": "Element Array",
                    "const": 34963,
                    "description": "The buffer view is used for vertex indices."
                },
                {
                    "title": "Custom Usage Target",
                    "type": "integer"
                }
            ]
        }
    },
    "required": [ "buffer", "byteLength" ]
}
