{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schema.khronos.org/gltf/2.0/specification/scene.schema.json",
    "title": "Scene",
    "type": "object",
    "description": "Visual objects, such as nodes, to render.",
    "$ref": "glTFChildOfRootProperty.schema.json",
    "properties": {
        "nodes": {
            "title": "Nodes",
            "type": "array",
            "description": "The root node indices.",
            "items": {
                "$ref": "glTFid.schema.json"
            },
            "uniqueItems": true,
            "minItems": 1
        }
    }
}
