{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schema.khronos.org/gltf/2.0/specification/camera.orthographic.schema.json",
    "title": "Camera Orthographic",
    "type": "object",
    "description": "Orthographic projection parameters.",
    "$ref": "glTFProperty.schema.json",
    "properties": {
        "xmag": {
            "title": "X Magnification",
            "type": "number",
            "description": "Horizontal magnification of the view."
        },
        "ymag": {
            "title": "Y Magnification",
            "type": "number",
            "description": "The vertical magnification of the view."
        },
        "zfar": {
            "title": "Z Far",
            "type": "number",
            "description": "The distance to the far clipping plane.",
            "exclusiveMinimum": 0.0
        },
        "znear": {
            "title": "Z Near",
            "type": "number",
            "description": "The distance to the near clipping plane.",
            "minimum": 0.0
        }
    },
    "required": [ "xmag", "ymag", "zfar", "znear" ]
}
